{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpotiLarp",
  "version": "0.1.1",
  "identifier": "com.spotilarp.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "SpotiLarp",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNUUyRUFCOUIyNkU0M0EKUldRNjVDYWJxeTVlSUpyOEI2K1V6My8yUi9kQnQ4ck44TERTNDBJWXVWU05HN0ZtbXIxcXhtdUIK",
      "endpoints": [
        "https://github.com/Exly78/SpotiLarp/releases/latest/download/latest.json"
      ]
    }
  }
}
